# ── LLM (all agents route through OpenRouter — see ADR-0005) ──────────────────
OPENROUTER_API_KEY=

# ── External evidence ─────────────────────────────────────────────────────────
EXA_API_KEY=

# ── Ambiguous workspace (REST: https://app.ambiguous.ai/api/) ─────────────────
AMBIGUOUS_API_KEY=
AMBIGUOUS_BASE_URL=https://app.ambiguous.ai/api

# ── CopilotKit (generative UI + Channels/Slack) ───────────────────────────────
COPILOTKIT_API_KEY=
NEXT_PUBLIC_COPILOTKIT_URL=/api/copilotkit

# ── Slack via CopilotKit managed Channels ─────────────────────────────────────
# The Slack bot token and signing secret are NOT set here. They are pasted into the
# CopilotKit Intelligence dashboard, which owns the Slack connection. See docs/WORKSTREAM-A.md.
CPK_INTELLIGENCE_API_KEY=
CHANNEL_CODE=
SLACK_DEMO_CHANNEL=#project-atlas

NEXT_PUBLIC_BASE_URL=http://localhost:3000
