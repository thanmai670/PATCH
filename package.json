{
  "name": "patch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env.local scripts/seed-workspace.ts",
    "seed:reset": "tsx --env-file=.env.local scripts/seed-workspace.ts --reset",
    "fixture:check": "tsx scripts/validate-fixture.ts",
    "watch:baseline": "tsx --env-file=.env.local scripts/detect-edits.ts --snapshot",
    "watch:detect": "tsx --env-file=.env.local scripts/detect-edits.ts",
    "test:repair": "tsx --env-file=.env.local scripts/test-all-scenarios.ts",
    "listener": "node --env-file=.env --env-file=.env.local scripts/slack-listener.mjs"
  },
  "dependencies": {
    "@copilotkit/channels": "0.9.2",
    "@copilotkit/react-core": "^1.10.6",
    "@copilotkit/react-ui": "^1.10.6",
    "@copilotkit/runtime": "^1.10.6",
    "exa-js": "^1.5.13",
    "next": "^16.3.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "reactflow": "^11.11.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
